# FiscAudit AI - Secrets template
#
# Copy to .streamlit/secrets.toml and fill in real values.
# Never commit secrets.toml (it is in .gitignore).
# On Streamlit Cloud: paste these into Settings -> Secrets instead of using a file.
#
# Key names are matched case-insensitively and several aliases are accepted,
# so GEMINI_API_KEY and google_api_key both work. Pick one per key.

# Google Gemini - https://aistudio.google.com/app/apikey
# aliases: google_api_key | GEMINI_API_KEY | GOOGLE_API_KEY
GEMINI_API_KEY = "your-gemini-key-here"

# Anthropic Claude - https://console.anthropic.com/settings/keys
# aliases: anthropic_api_key | Claude_api_key | ANTHROPIC_API_KEY
Claude_api_key = "your-claude-key-here"

# Supabase - https://supabase.com/dashboard -> Project Settings -> API
# Optional: without these the app runs but does not persist results.
# aliases: supabase_url | SUPABASE_URL
supabase_url = "https://your-project-id.supabase.co"
# aliases: supabase_key | SUPABASE_KEY | supabase_anon_key
supabase_key = "your-supabase-key-here"
