# FiscAudit AI - Streamlit Secrets Template
# ============================================================================
# INSTRUCTIES:
# 1. Kopieer dit bestand naar .streamlit/secrets.toml (wordt niet in Git gecommit)
# 2. Vul alle keys hieronder in met je werkelijke credentials
# 3. LET OP: secrets.toml staat in .gitignore, dus zorg dat je deze NOOIT committet!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
supabase_url = "https://your-project.supabase.co"
supabase_key = "your-anon-public-key-here"
supabase_service_role = "your-service-role-key-here"  # Voor admin operaties (optioneel)

# ============================================================================
# GOOGLE GEMINI API
# ============================================================================
google_api_key = "your-google-gemini-api-key-here"
gemini_model = "gemini-1.5-pro-vision-latest"

# ============================================================================
# ANTHROPIC CLAUDE API
# ============================================================================
anthropic_api_key = "your-anthropic-api-key-here"
claude_model = "claude-3-5-sonnet-20241022"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
app_name = "FiscAudit AI"
app_version = "1.0.0"
environment = "development"  # 'development' of 'production'
debug_mode = true

# ============================================================================
# OPTIONAL: AFAS/ERP CREDENTIALS (voor toekomstige integratie)
# ============================================================================
# afas_url = "https://your-afas-instance.afas.online"
# afas_token = "your-afas-api-token-here"

# ============================================================================
# OPTIONAL: MAIL SETTINGS (voor email-verzending)
# ============================================================================
# smtp_server = "smtp.gmail.com"
# smtp_port = 587
# smtp_username = "your-email@gmail.com"
# smtp_password = "your-app-password-here"
# sender_email = "audit@yourcompany.nl"
