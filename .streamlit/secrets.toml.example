# FiscAudit AI - Streamlit Secrets Configuration
# IMPORTANT: This is a TEMPLATE file. Copy this to secrets.toml and fill in your actual keys.
# NEVER commit secrets.toml to GitHub - it's in .gitignore for security!

# ============================================================================
# AI & LLM API KEYS
# ============================================================================

# Google Generative AI (Gemini) API Key
# Get from: https://makersuite.google.com/app/apikey
google_api_key = "your-google-api-key-here"

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/account/keys
anthropic_api_key = "your-anthropic-api-key-here"

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Supabase Project URL
# Get from: https://supabase.com/dashboard
supabase_url = "https://your-project-id.supabase.co"

# Supabase Anon Key (service role key for backend)
# Get from: https://supabase.com/dashboard/project/[id]/settings/api
supabase_key = "your-supabase-key-here"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application environment (development, staging, production)
environment = "development"

# Debug mode (enable verbose logging)
debug = false

# ============================================================================
# HOW TO USE
# ============================================================================
# 1. Copy this file: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Edit secrets.toml and fill in your actual API keys
# 3. Keep secrets.toml in .gitignore (never commit to GitHub)
# 4. Access secrets in Python: st.secrets["google_api_key"]
# 5. On Streamlit Cloud, add secrets via: Settings → Secrets
